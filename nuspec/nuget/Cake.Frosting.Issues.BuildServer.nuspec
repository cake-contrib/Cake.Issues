<?xml version="1.0" encoding="utf-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <metadata xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <id>Cake.Frosting.Issues.BuildServer</id>
    <title>Cake.Frosting.Issues.BuildServer</title>
    <version>0.0.0</version>
    <authors>Cake Issues contributors</authors>
    <owners>bbtsoftware, pascalberger, cake-contrib</owners>
    <summary>Cake Frosting addin for reporting issues to build servers</summary>
    <description>
The issues addin for Cake allows you to report issues to build servers.

This addin provides the aliases for reporting issues to build servers in Cake Frosting.
It requires the core Cake.Frosting.Issues addin and one or more issue provider addins for reading issues from different analyzers or linters.

See the Project Site for an overview of the whole ecosystem of addins for working with issues in Cake scripts.
    </description>
    <license type="expression">MIT</license>
    <projectUrl>https://cakeissues.net</projectUrl>
    <icon>icon.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <repository type="git" url="https://github.com/cake-contrib/Cake.Issues.git"/>
    <copyright>Copyright © Cake Issues contributors</copyright>
    <tags>cake cake-frosting cake-issues build-server ci issues</tags>
    <readme>docs\README.md</readme>
    <releaseNotes>https://github.com/cake-contrib/Cake.Issues/releases/tag/5.8.0</releaseNotes>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Cake.Core" version="6.0" exclude="Build,Analyzers" />
        <dependency id="Cake.Issues" version="[5.0.0-beta0001,6.0)" exclude="Build,Analyzers" />
        <dependency id="Spectre.Console" version="0.53.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Cake.Core" version="6.0" exclude="Build,Analyzers" />
        <dependency id="Cake.Issues" version="[5.0.0-beta0001,6.0)" exclude="Build,Analyzers" />
        <dependency id="Spectre.Console" version="0.53.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Cake.Core" version="6.0" exclude="Build,Analyzers" />
        <dependency id="Cake.Issues" version="[5.0.0-beta0001,6.0)" exclude="Build,Analyzers" />
        <dependency id="Spectre.Console" version="0.53.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="icon.png" target="" />
    <file src="Cake.Frosting.Issues.BuildServer.targets" target="build" />
    <file src="Cake.Frosting.Issues.BuildServer.targets" target="buildTransitive" />
    <file src="Cake.Frosting.Issues.BuildServer.md" target="docs\README.md" />
    <file src="..\..\src\Core\Cake.Issues.BuildServer\Cake.Issues.BuildServer\bin\Release\**\Cake.Issues.BuildServer.*" target="lib" exclude="**\*.deps.json" />
  </files>
</package>