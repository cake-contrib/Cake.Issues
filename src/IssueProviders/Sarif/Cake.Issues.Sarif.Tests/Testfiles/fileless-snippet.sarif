{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "CodeScanner" } },
      "artifacts": [
        { "sourceLanguage": "csharp" }
      ],
      "results": [
        {
          "ruleId": "C2001",
          "level": "warning",
          "message": { "text": "Found issue." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "index": 0 },
                "region": { "snippet": { "text": "var value = 42;" } }
              }
            }
          ]
        }
      ]
    }
  ]
}
