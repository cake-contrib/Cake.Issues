{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>cake-contrib/renovate-presets:cake-issues"
  ],
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions of NuGet packages used in documentation",
      "managerFilePatterns": [
        "/docs/mkdocs.yml$/"
      ],
      "matchStrings": [
        "\\s*#\\srenovate:\\sdatasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\s*.*?_version\\s*:\\s*(?<currentValue>.*)"
      ]
    },
    {
      "customType": "regex",
      "description": "Nuspec files manager",
      "managerFilePatterns": [
        "/\\.nuspec$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "<dependency\\b[^>]*\\bid=\\\"(?<depName>[^\\\"]+)\\\"[^>]*\\bversion=\\\"(?<currentValue>[^\\[\\(][^\\\"]*)\\\"[^>]*\\/?>",
        "<dependency\\b[^>]*\\bversion=\\\"(?<currentValue>[^\\[\\(][^\\\"]*)\\\"[^>]*\\bid=\\\"(?<depName>[^\\\"]+)\\\"[^>]*\\/?>"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Update jQuery version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.JQueryVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>jquery</c> is <c>(?<currentValue>[^<]+)</c>",
        "ajax\\.aspnetcdn\\.com/ajax/jquery/jquery-(?<currentValue>\\d[^/\"<]*?)\\.min\\.js"
      ],
      "depNameTemplate": "jquery",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update DevExtreme version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.DevExtremeVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>devextreme</c> is <c>(?<currentValue>[^<]+)</c>",
        "cdn3\\.devexpress\\.com/jslib/(?<currentValue>\\d[^/\"<]*)/"
      ],
      "depNameTemplate": "devextreme",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update ExcelJS version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.ExcelJsVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>exceljs</c> is <c>(?<currentValue>[^<]+)</c>",
        "cdnjs\\.cloudflare\\.com/ajax/libs/exceljs/(?<currentValue>\\d[^/\"<]*)/"
      ],
      "depNameTemplate": "exceljs",
      "packageNameTemplate": "exceljs/exceljs.min.js",
      "datasourceTemplate": "cdnjs"
    },
    {
      "customType": "regex",
      "description": "Update FileSaver.js version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.FileSaverJsVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>FileSaver\\.js</c> is <c>(?<currentValue>[^<]+)</c>",
        "cdnjs\\.cloudflare\\.com/ajax/libs/FileSaver\\.js/(?<currentValue>\\d[^/\"<]*)/"
      ],
      "depNameTemplate": "FileSaver.js",
      "packageNameTemplate": "FileSaver.js/FileSaver.min.js",
      "datasourceTemplate": "cdnjs"
    },
    {
      "customType": "regex",
      "description": "Update jsPDF version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.JsPdfVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>jspdf</c> is <c>(?<currentValue>[^<]+)</c>",
        "cdnjs\\.cloudflare\\.com/ajax/libs/jspdf/(?<currentValue>\\d[^/\"<]*)/"
      ],
      "depNameTemplate": "jspdf",
      "packageNameTemplate": "jspdf/jspdf.umd.min.js",
      "datasourceTemplate": "cdnjs"
    },
    {
      "customType": "regex",
      "description": "Update jsPDF-AutoTable version used by the DxDataGrid report template",
      "managerFilePatterns": [
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/Templates/DxDataGrid\\.cshtml$/",
        "/src/ReportFormats/Generic/Cake\\.Issues\\.Reporting\\.Generic/HtmlDxDataGridOption\\.cs$/",
        "/docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-.+\\.html$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ViewBag\\.JsPdfAutoTableVersion,\\s*\"(?<currentValue>[^\"]+)\"",
        "Default value for <c>jspdf-autotable</c> is <c>(?<currentValue>[^<]+)</c>",
        "cdnjs\\.cloudflare\\.com/ajax/libs/jspdf-autotable/(?<currentValue>\\d[^/\"<]*)/"
      ],
      "depNameTemplate": "jspdf-autotable",
      "packageNameTemplate": "jspdf-autotable/jspdf.plugin.autotable.min.js",
      "datasourceTemplate": "cdnjs"
    }
  ],
  "packageRules": [
    {
      "description": "CDN dependencies of the DxDataGrid report template are handled by dedicated custom managers, which keep the Razor template, the option documentation and the generated demo reports in sync. The built-in html manager only detects cdnjs.cloudflare.com URLs in the generated demo reports and would therefore report the same dependencies again.",
      "matchManagers": [
        "html"
      ],
      "enabled": false
    },
    {
      "description": "htmldxdatagrid-demo-customscriptlocation.html intentionally references outdated versions to demonstrate the custom script location and version options",
      "matchFileNames": [
        "docs/input/documentation/report-formats/generic/templates/htmldxdatagrid-demo-customscriptlocation.html"
      ],
      "enabled": false
    },
    {
      "description": "Ignore Cake runner minor and patch updates",
      "matchDepNames": [
        "Cake.Tool",
        "Cake.Frosting"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Ignore Cake.AzureDevOps minor and patch updates",
      "matchDepNames": [
        "Cake.AzureDevOps",
        "Cake.Frosting.AzureDevOps"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Do not update Microsoft.Build.* packages in Cake.Issues.MsBuild since required version depends on the version used in MSBuild.StructuredLogger",
      "matchFileNames": [
        "src/Cake.Issues.MsBuild/Cake.Issues.MsBuild.csproj",
        "src/Cake.Issues.MsBuild.Tests/Cake.Issues.MsBuild.Tests.csproj"
      ],
      "matchDepNames": [
        "Microsoft.Build.Framework",
        "Microsoft.Build.Utilities.Core"
      ],
      "enabled": false
    }
  ]
}
