<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../common/frosting/Program.cs" Link="Program.cs" />
    <PackageReference Include="Cake.Frosting" Version="7.0.0" />
    <PackageReference Include="Cake.Issues" Version="*-*" />
    <PackageReference Include="Cake.Frosting.Issues.Reporting" Version="*-*" />
    <PackageReference Include="Cake.Frosting.Issues.Reporting.Console" Version="*-*" />
  </ItemGroup>
</Project>